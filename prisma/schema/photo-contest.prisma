enum PhotoContestStatus {
  /// not visible in the app at all
  HIDDEN

  /// photos are visible and voting is open
  ACTIVE

  /// photos are visible, but voting is closed and the results stay hidden
  CLOSED_HIDDEN

  /// photos and the final results are visible
  CLOSED
}

model PhotoContest {
  id          String             @id @default(uuid(7))
  slug        String             @unique
  title       String
  description String?
  status      PhotoContestStatus @default(HIDDEN)

  votingStart DateTime?
  votingEnd   DateTime?

  maxPointsPerUser  Int @default(2)
  maxPointsPerImage Int @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images PhotoContestImage[]
  votes  PhotoContestVote[]

  @@index([status])
  @@index([slug])
}

model PhotoContestImage {
  id        String       @id @default(uuid(7))
  contestId String
  contest   PhotoContest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  imageUrl     String
  thumbnailUrl String?
  title        String?
  description  String?
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [uuid])

  order     Int      @default(0)
  createdAt DateTime @default(now())

  votes PhotoContestVote[]

  @@index([contestId])
  @@index([uploadedById])
}

model PhotoContestVote {
  id        String       @id @default(uuid(7))
  contestId String
  contest   PhotoContest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  imageId String
  image   PhotoContestImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [uuid], onDelete: Cascade)

  points    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contestId, userId, imageId])
  @@index([contestId, userId])
  @@index([imageId])
}
