/// a shelf of the material catalogue, e.g. J+S-Material or Verbrauchsmaterial
model MaterialCategory {
  id        String @id @default(uuid(7))
  name      String @unique
  sortOrder Int    @default(0)

  items MaterialItem[]
}

/// one article of the material catalogue. The quantities count pieces, not labels: an article
/// owns `totalQuantity` pieces, of which the damaged and the ones in repair cannot be lent.
model MaterialItem {
  id                 String  @id @default(uuid(7))
  /// short code printed on the QR label, opens the article when scanned
  code               String  @unique
  name               String
  description        String  @default("")
  usageNotes         String?
  returnInstructions String  @default("")
  imageUrl           String?
  /// what one piece is called, e.g. "Stück" or "Rollen"
  unit               String  @default("Stück")

  categoryId String
  category   MaterialCategory @relation(fields: [categoryId], references: [id])

  totalQuantity     Int
  /// most pieces a single loan may ask for
  maxLoanQuantity   Int
  /// a participant asks for multiples of it, e.g. 10 for Zelttücher; the material team books
  /// any number, so it can hand out the last few
  orderStep         Int @default(1)
  damagedQuantity   Int @default(0)
  inRepairQuantity  Int @default(0)
  /// the dashboard warns once the free pieces drop to this number
  lowStockThreshold Int @default(0)

  /// handed out and used up, so a return is optional and the stock shrinks on issue
  isConsumable Boolean @default(false)
  /// can be prepared ahead for a pickup; otherwise the material team only hands it out at once
  isReservable Boolean @default(true)
  /// withdrawn by the material team, nothing can be handed out
  isDisabled   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans     MaterialLoan[]
  incidents MaterialIncident[]

  @@index([categoryId])
}

enum MaterialLoanStatus {
  /// asked for by a Hof or a participant, not yet confirmed; the pieces are already held
  REQUESTED
  /// confirmed or prepared by the material team for a pickup, the pieces are held
  RESERVED
  /// handed out, the pieces are away
  ISSUED
  /// back at the material depot
  RETURNED
  /// consumables handed out for good
  CONSUMED
  CANCELLED
}

enum MaterialCondition {
  OK
  LIGHT_DAMAGE
  DAMAGED
  MISSING
}

/// one request, reservation or loan of one article, booked on a Hof or on a person. Overdue is not a
/// status: it is an issued loan whose end date lies in the past.
model MaterialLoan {
  id     String @id @default(uuid(7))
  /// short number printed on the loan's QR label and spoken at the counter
  number Int    @unique @default(autoincrement())

  itemId String
  item   MaterialItem @relation(fields: [itemId], references: [id])

  quantity Int

  /// id of the Hof in Payload's `hoefe` collection; no foreign key, the Hof lives in MongoDB.
  /// Empty only for a loan booked on a person without a Hof: every loan has a Hof or a person,
  /// which the API checks, since the Hof cannot be a foreign key.
  hofId String?

  /// set when the material is lent to one person; the loan then belongs to them, not the Hof
  personId String?
  person   User?   @relation("MaterialLoanPerson", fields: [personId], references: [uuid])

  responsibleName String
  comment         String?

  startDate DateTime
  endDate   DateTime

  /// consumables handed out to be used up rather than lent
  isConsumption Boolean @default(false)

  status MaterialLoanStatus

  issuedQuantity Int?
  issuedAt       DateTime?

  /// the borrower said the material is on its way back, the material team has not checked it
  returnAnnouncedAt DateTime?
  returnedQuantity  Int?
  returnedAt        DateTime?
  returnCondition   MaterialCondition?
  returnNote        String?
  /// why the material team turned a request down, shown to whoever asked
  rejectionReason   String?

  createdById String
  createdBy   User   @relation("MaterialLoanCreatedBy", fields: [createdById], references: [uuid])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents MaterialIncident[]

  @@index([itemId, status])
  @@index([hofId])
  @@index([personId])
  @@index([createdById])
  @@index([status, endDate])
}

/// a damage or a loss, reported at a return or on its own, for the material team to follow up
model MaterialIncident {
  id String @id @default(uuid(7))

  itemId String
  item   MaterialItem @relation(fields: [itemId], references: [id])

  loanId String?
  loan   MaterialLoan? @relation(fields: [loanId], references: [id])

  condition MaterialCondition
  quantity  Int
  note      String
  /// object key in the S3 bucket
  photoKey  String?

  reportedById String?
  reportedBy   User?   @relation("MaterialIncidentReportedBy", fields: [reportedById], references: [uuid])

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([itemId])
  @@index([resolvedAt])
}
