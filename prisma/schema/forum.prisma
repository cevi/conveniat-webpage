/// Where a forum post stands. Changed by the topic's admins, the piket on duty and the helpers
/// it was assigned to, see `resolveForumModerator`.
enum ForumPostStatus {
  OPEN
  IN_PROGRESS
  DONE
}

/// The forum part of a top-level message in a `FORUM` chat. The message is the post: its text is
/// the description, its thread the comments, a 👍 reaction on it "betrifft mich auch". Everything
/// the message cannot hold, because someone other than its sender changes it, lives here.
model ForumPost {
  messageId String  @id
  message   Message @relation(fields: [messageId], references: [uuid], onDelete: Cascade)

  /// the topic, the chat of the message
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [uuid], onDelete: Cascade)

  title String

  status            ForumPostStatus @default(OPEN)
  statusChangedAt   DateTime?
  statusChangedById String?

  /// the place the post is about, picked by the author on the map; never the phone's position
  /// on its own, see the composer
  longitude    Float?
  latitude     Float?
  /// the map entry in Payload's `camp-map-annotations` the place belongs to; no foreign key, the
  /// annotations live in MongoDB
  annotationId String?

  /// set while the post is pinned above the others of its topic
  pinnedAt        DateTime?
  /// the comment marked as the answer, shown above the other comments
  answerMessageId String?
  /// the post this duplicate was merged into; a merged post leaves the lists, and its likes count
  /// for the post it was merged into
  mergedIntoId    String?

  createdAt DateTime @default(now())

  assignments ForumPostAssignment[]

  @@index([chatId, createdAt])
  @@index([status])
  @@index([annotationId])
  @@index([latitude, longitude])
  @@index([mergedIntoId])
}

/// A post handed to one person, a helper sent out to fix what it reports. While it is open, the
/// helper may change the status of this one post and nothing else.
model ForumPostAssignment {
  id String @id @default(uuid(7))

  messageId String
  post      ForumPost @relation(fields: [messageId], references: [messageId], onDelete: Cascade)

  assigneeId String
  assignee   User   @relation("ForumPostAssignee", fields: [assigneeId], references: [uuid])

  assignedById String
  assignedBy   User   @relation("ForumPostAssigner", fields: [assignedById], references: [uuid])

  note String?

  /// whether the assignment made the helper a member of the topic, which ending it undoes
  addedMembership Boolean @default(false)

  createdAt DateTime  @default(now())
  /// withdrawn, or the post was set to done; an ended assignment grants nothing
  endedAt   DateTime?
  endedById String?

  @@index([messageId, endedAt])
  @@index([assigneeId, endedAt])
}

/// Someone who wants a push for every comment and status change of one post, the post being the
/// top-level message of the thread. Writing a post or a comment subscribes its author.
model ThreadSubscription {
  userId String
  user   User   @relation(fields: [userId], references: [uuid])

  messageId String
  message   Message @relation(fields: [messageId], references: [uuid], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, messageId])
  @@index([messageId])
}

enum ForumAuditAction {
  STATUS_CHANGED
  PINNED
  UNPINNED
  ANSWER_MARKED
  ANSWER_UNMARKED
  MERGED
  UNMERGED
  /// a post or a comment deleted for everyone by someone other than its author
  DELETED
  ASSIGNED
  ASSIGNMENT_ENDED
}

/// Why someone was allowed to change a post.
enum ForumActorCapacity {
  /// an owner or admin of the topic's chat, its Kernteam
  TOPIC_ADMIN
  /// on duty in a piket schedule entry for forum chats
  PIKET
  /// a helper with an open assignment for this post
  DELEGATE
}

/// Every change someone made to a post they did not write: who, in which capacity, what before
/// and after. Append only, a trigger refuses updates and deletes. No foreign keys and copies of
/// the names and titles, so the protocol outlives a deleted post, topic or person.
model ForumAuditEvent {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  action ForumAuditAction

  chatId    String
  topicName String
  /// the post
  messageId String
  postTitle String
  /// the comment, for a deleted or marked comment
  commentId String?

  actorId   String
  actorName String
  capacity  ForumActorCapacity

  /// the shift that made the actor piket, copied in case the schedule entry changes later
  piketScheduleId String?
  shiftStart      DateTime?
  shiftEnd        DateTime?

  /// the assignment that made the actor a helper, and who handed it out
  assignmentId    String?
  delegatedById   String?
  delegatedByName String?

  before Json?
  after  Json?
  /// what the actor wrote about the change, e.g. what was done; public on a status change
  note   String?

  @@index([createdAt])
  @@index([chatId, createdAt])
  @@index([actorId, createdAt])
  @@index([messageId, createdAt])
}
