{
  "name": "conveniat27",
  "version": "1.2.3",
  "description": "The official website of conveniat27",
  "license": "MIT",
  "author": "Cyrill Püntener v/o JPG (cyrill.puentener@cevi.ch)",
  "maintainers": [
    "Cyrill Püntener v/o JPG (cyrill.puentener@cevi.ch)",
    "Matthias Hüppi v/o Scirocco (scirocco@cevi.ch)"
