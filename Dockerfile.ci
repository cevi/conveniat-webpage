# Dockerfile.ci
# This Dockerfile is optimized for CI/CD environments where the Next.js application
# is already built on the host machine (e.g., in a GitHub Actions runner).
# This allows the CI runner to leverage native caching for .next/cache and node_modules.

FROM node:24.15-alpine AS runner
WORKDIR /app

# Same runtime packages as the `base` stage of Dockerfile. curl is what the swarm
# healthcheck shells out to (`curl -fs http://localhost:3000/status`); without it the
# check can never pass and the container is killed on a loop regardless of app health.
RUN apk add --no-cache curl libc6-compat poppler-utils vips vips-dev

ENV NODE_ENV=production
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1
ENV TZ="Europe/Zurich"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Set the correct permission for prerender cache
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Copy pre-built standalone output and static files from the host machine
# (Built by `pnpm run build` in GitHub Actions)
COPY --chown=nextjs:nodejs public ./public
COPY --chown=nextjs:nodejs .next/standalone ./
COPY --chown=nextjs:nodejs .next/static ./.next/static
COPY --chown=nextjs:nodejs .next/cache/fs-fallback ./.next/cache/fs-fallback

# Copy Prisma client generated on the host
COPY --chown=nextjs:nodejs src/lib/prisma/ ./src/lib/prisma/

USER nextjs
EXPOSE 3000

CMD ["node", "server.js"]
