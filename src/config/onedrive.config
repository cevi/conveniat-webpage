# Configuration for the abraunegg/onedrive client that syncs the bill archive.
#
# Mounted read-only into the `onedrive` container. The OAuth refresh token is NOT kept here
# — it lives beside this file in the container's config volume, written by the one-time
# sign-in described in docs/bill-archive-onedrive.md.
#
# The target is a SharePoint document library, not a personal OneDrive:
#
#   site    ConveniatDue-TeamFinanzen
#   library Freigegebene Dokumente
#   folder  Ressort Finanzen/97_Rechnungen_LB/Normal
#
# It appears in Cyrill's OneDrive as the shortcut "conveniat27-Ressort Finanzen - Normal",
# but that shortcut is a remoteItem, and the sync client does not follow those. It has to be
# pointed at the library itself, which is what `drive_id` below does.

# The local spool. Its root maps to the root of the document library, which is why
# BILL_ARCHIVE_DIR points at the subfolder inside it rather than here.
sync_dir = "/onedrive/data"

# The document library to sync. Resolve it once with, inside the container:
#
#   onedrive --get-sharepoint-drive-id "ConveniatDue-TeamFinanzen"
#
# and paste the id for the "Freigegebene Dokumente" library here. Without it the client
# syncs the account's personal OneDrive instead, which is the wrong drive entirely.
# drive_id = "b!..."

# SharePoint rewrites files as they are uploaded — it stamps its own metadata onto them —
# so the size and hash the client checks after an upload never match what it sent. With
# validation on, every bill is reported as a failed upload and retried forever. This is a
# SharePoint-only quirk and the documented way around it.
disable_upload_validation = "true"

# This is an archive, not a sync. Both of these matter:
#
#   upload_only      never pull anything down, so nothing in the library can overwrite or
#                    resurrect a local file.
#   no_remote_delete never delete in SharePoint because a local file went away, and never
#                    delete locally because a remote one did.
#
# The second one is doing real work here: the library is the finance team's, they have other
# folders in it, and people move things around. Without the pair, a tidy-up on either side
# propagates to the other and takes bills with it.
upload_only = "true"
no_remote_delete = "true"

# Restricts the client to the archive folder. The rest of the finance library is none of its
# business, and enumerating it on every run is slow enough to invite throttling.
sync_root_files = "false"

# Watch the spool rather than polling it, and reconcile every five minutes as a backstop in
# case an inotify event is missed.
monitor_interval = "300"

# Bills are written to a temporary name and renamed into place, so a partial file should
# never be visible. This is the second line of defence in case that ever changes.
skip_file = "~*|.~*|*.tmp|*.swp|*.part-*"
skip_dotfiles = "true"

# Surface throttling and upload failures in the container log, which is the only place an
# operator can see that the archive has stopped working.
enable_logging = "true"
log_dir = "/var/log/onedrive/"
