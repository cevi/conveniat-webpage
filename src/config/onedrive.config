# Configuration for the abraunegg/onedrive client that syncs the bill archive.
#
# Mounted read-only into the `onedrive` container. The OAuth refresh token is NOT kept here
# — it lives beside this file in the container's config volume, written by the one-time
# sign-in described in docs/bill-archive-onedrive.md.

# The spool directory payload writes bills into.
sync_dir = "/onedrive/data"

# Where the bills land in OneDrive. Relative to the account's drive root.
sync_dir_permissions = "0700"
sync_file_permissions = "0600"

# This is an archive, not a sync. Both of these matter:
#
#   upload_only      never pull anything down, so nothing in OneDrive can overwrite or
#                    resurrect a local file.
#   no_remote_delete never delete in OneDrive because a local file went away, and never
#                    delete locally because a remote one did. Someone tidying the OneDrive
#                    folder must not be able to empty the spool, and vice versa.
#
# Without the pair, a stray delete on either side propagates to the other and takes bills
# with it.
upload_only = "true"
no_remote_delete = "true"

# Watch the spool rather than polling it, and reconcile every five minutes as a backstop in
# case an inotify event is missed.
monitor_interval = "300"

# Bills are written to a temporary name and renamed into place, so a partial file should
# never be visible. This is the second line of defence in case that ever changes.
skip_file = "~*|.~*|*.tmp|*.swp|*.part-*"
skip_dotfiles = "true"

# Surface throttling and upload failures in the container log, which is the only place an
# operator can see that the archive has stopped working.
enable_logging = "true"
log_dir = "/var/log/onedrive/"
